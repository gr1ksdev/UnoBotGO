# Telegram Bot Token (obrigatório)
TOKEN=

# polling | webhook
TELEGRAM_MODE=polling

# PostgreSQL (obrigatório; migrations verificadas/aplicadas no startup)
DATABASE_URL=postgres://unobot:change-me@localhost:5432/unobot?sslmode=disable

# Tempo máximo sem ação antes de pular o turno
TURN_TIMEOUT=2m

# Servidor HTTP compartilhado
WEB_ADDR=:8080

# Segredo do Mini App: exatamente 32 bytes em Base64 (obrigatório)
# Gere com: openssl rand -base64 32
MINIAPP_SECRET=

# Somente se TELEGRAM_MODE=webhook: endpoint público HTTPS com caminho dedicado.
# A URL não pode ser descoberta a partir de WEB_ADDR. Exemplo:
# WEBHOOK_URL=https://bot.exemplo.com/telegram
