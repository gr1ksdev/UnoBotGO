# Telegram Bot Token
TOKEN=

# polling | webhook
TELEGRAM_MODE=polling

# PostgreSQL
DATABASE_URL=postgres://unobot:change-me@localhost:5432/unobot?sslmode=disable

# Tempo máximo sem ação antes de pular o turno
TURN_TIMEOUT=2m

# Servidor HTTP compartilhado
WEB_ADDR=:8080

# Segredo do Mini App: 32 bytes em Base64
# Gere com: openssl rand -base64 32
MINIAPP_SECRET=

# Somente com TELEGRAM_MODE=webhook: endpoint público HTTPS com path dedicado.
# WEBHOOK_URL=https://bot.exemplo.com/telegram
