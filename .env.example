# Telegram Bot Token (obrigatório)
TOKEN=

# polling | webhook
# polling é o padrão local; use webhook em produção atrás de HTTPS.
TELEGRAM_MODE=polling

# PostgreSQL (obrigatório; migrations verificadas/aplicadas no startup)
DATABASE_URL=postgres://unobot:change-me@localhost:5432/unobot?sslmode=disable

# Tempo máximo sem ação antes de pular o turno
TURN_TIMEOUT=2m

# Sondas de saúde e endpoint do webhook
WEB_ADDR=:8080

# Somente se TELEGRAM_MODE=webhook:
# SECRET_KEY: exatamente 32 bytes em Base64. Gere com: openssl rand -base64 32
# WEBHOOK_URL: endpoint público HTTPS com caminho dedicado.
# A URL não pode ser descoberta a partir de WEB_ADDR. Exemplo:
# SECRET_KEY=
# WEBHOOK_URL=https://bot.exemplo.com/telegram
