# Telegram Bot Token (obrigatório)
TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_12345

# Nível de log estruturado: debug, info, warn, error (padrão: info)
LOG_LEVEL=info

# Limite de resumos de partidas finalizadas mantidos em memória (padrão: 100)
HISTORY_LIMIT=100

# Duração do token de ação e cursor inline (padrão: 2m)
INLINE_TOKEN_TTL=2m

# Limite global de tokens na memória (padrão: 20000)
INLINE_TOKEN_LIMIT=20000

# Limite de tokens por usuário na memória (padrão: 512)
INLINE_TOKEN_USER_LIMIT=512

# Tempo máximo sem ação antes de pular o turno
TURN_TIMEOUT=2m

TELEGRAM_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_DROP_PENDING_UPDATES=false

# Mini App & Servidor HTTP Compartilhado
WEB_ADDR=:8080
# MINIAPP_SECRET deve ser uma chave de 32 bytes em base64 (gere com: openssl rand -base64 32)
MINIAPP_SECRET=
# Direct link t.me para o Mini App (ex: https://t.me/MeuBot/ranking); se omitido, botão inline não é exibido
MINIAPP_LAUNCH_URL=
TELEGRAM_INITDATA_MAX_AGE=1h
MIGRATION_TIMEOUT=2m

# PostgreSQL V2 obrigatório; migrações são verificadas/aplicadas automaticamente no startup.
DATABASE_URL=postgres://unobot:change-me@localhost:5432/unobot?sslmode=disable
