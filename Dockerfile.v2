# Stage 1: Build the single Go binary
FROM --platform=$BUILDPLATFORM golang:1.26.3-bookworm AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-w -s" -o /build/unobotgo ./cmd/bot

# Stage 2: Minimal non-root distroless runtime
FROM gcr.io/distroless/static-debian12:nonroot

EXPOSE 8080

COPY --from=builder /build/unobotgo /unobotgo

ENTRYPOINT ["/unobotgo"]
